# Copy to .env (git-ignored). Both keys are optional; with neither, the retriever alone is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model (default gpt-4.1-mini for OpenAI, claude-haiku-4-5 for Anthropic)
# LLM_MODEL=gpt-4o-mini
# Only needed behind a proxy; the graders pass this themselves
# HTTPS_PROXY=
